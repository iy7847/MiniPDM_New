{
  "name": "minipdm",
  "private": true,
  "version": "1.2.4",
  "description": "소규모 금속 가공 제조업체용 견적·수주·생산·출하 통합관리 솔루션",
  "author": "KEP (kendp.com)",
  "homepage": "https://kendp.com",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "release:upload": "node scripts/upload-release-to-r2.mjs",
    "lint": "oxlint src",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "build": {
    "appId": "com.kendp.minipdm",
    "productName": "MiniPDM",
    "copyright": "Copyright © 2026 KEP. All rights reserved.",
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://storage.kendp.com/updates/"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MiniPDM"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-table": "^8.21.3",
    "chart.js": "^4.5.1",
    "chartjs-plugin-dragdata": "^2.3.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "html2pdf.js": "^0.14.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.23.0",
    "occt-import-js": "^0.0.23",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-barcode": "^1.6.1",
    "react-chartjs-2": "^5.3.1",
    "react-datasheet-grid": "^4.11.6",
    "react-dom": "^18.3.1",
    "react-pdf": "^10.4.1",
    "react-qr-code": "^2.2.0",
    "react-rnd": "^10.5.3",
    "react-router-dom": "^7.18.1",
    "react-to-print": "^3.3.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.16",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
